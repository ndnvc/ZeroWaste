<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Makanan"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#1A1D20" />

            <TextView
                android:id="@+id/tvHistoryStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="Tersedia"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="#2E7D32"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvHistoryDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detail riwayat..."
            android:textSize="14sp"
            android:textColor="#6C757D"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHistoryQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Porsi: 3 Pax"
                android:textSize="13sp"
                android:textColor="#495057"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#CED4DA"
                android:layout_marginHorizontal="12dp" />

            <TextView
                android:id="@+id/tvHistoryExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exp: Jam 20:00"
                android:textSize="13sp"
                android:textColor="#D32F2F" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelHistoryDonation"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Batalkan Donasi"
            android:textSize="14sp"
            android:textColor="#D32F2F"
            app:strokeColor="#D32F2F"
            app:cornerRadius="8dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>