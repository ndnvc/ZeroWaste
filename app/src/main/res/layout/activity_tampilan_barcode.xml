<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".tampilan_barcode">

    <TextView
        android:id="@+id/tvBarcodeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Barcode Pengambilan"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:textColor="#1A1D20"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvFoodNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama Makanan"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#2E7D32"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvBarcodeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/tvFoodNameLabel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDetailDonor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donatur: -"
                android:textSize="14sp"
                android:textColor="#495057" />

            <TextView
                android:id="@+id/tvDetailLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lokasi: -"
                android:textSize="14sp"
                android:textColor="#495057" />

            <TextView
                android:id="@+id/tvDetailDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jarak: - km"
                android:textSize="14sp"
                android:textColor="#495057" />

            <TextView
                android:id="@+id/tvDetailExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Batas Waktu: -"
                android:textSize="14sp"
                android:textColor="#D32F2F" />

            <TextView
                android:id="@+id/tvDetailQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sisa: - Pax"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="8dp" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deskripsi: -"
                android:textSize="13sp"
                android:textColor="#6C757D"
                android:maxLines="3"
                android:ellipsize="end" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dummy Barcode Placeholder -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBarcode"
        android:layout_width="320dp"
        android:layout_height="140dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/cardDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="12dp">

            <!-- Simulasi Barcode 1D yang lebih realistis menggunakan View -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center">
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="5dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="3dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="6dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="3dp"/>
                <View android:layout_width="5dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvBarcodeNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZW-2023-1205-8842"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.3"
                android:fontFamily="monospace"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvInstructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tunjukkan barcode ini kepada donatur untuk diverifikasi saat pengambilan makanan."
        android:textAlignment="center"
        android:textSize="14sp"
        android:textColor="#6C757D"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@id/cardBarcode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimulateDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Simulate Done"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="16dp"
        app:backgroundTint="#2E7D32"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnBatal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBatal"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Batal"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="40dp"
        app:strokeColor="#D32F2F"
        android:textColor="#D32F2F"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>