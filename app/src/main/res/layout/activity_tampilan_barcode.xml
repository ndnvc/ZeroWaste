<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FB"
    tools:context=".tampilan_barcode">

    <TextView
        android:id="@+id/tvBarcodeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Barcode Verifikasi"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textColor="#212121"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvFoodNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama Makanan"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#E64A19"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvBarcodeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvFoodNameLabel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDetailDonor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donatur: -"
                android:textSize="14sp"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvDetailLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lokasi: -"
                android:textSize="14sp"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvDetailDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jarak: - km"
                android:textSize="14sp"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvDetailExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Batas Waktu: -"
                android:textSize="14sp"
                android:textColor="#D32F2F"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sisa: - Pax"
                android:textSize="14sp"
                android:textColor="#2E7D32"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="10dp" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deskripsi: -"
                android:textSize="13sp"
                android:textColor="#757575"
                android:maxLines="3"
                android:ellipsize="end" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBarcode"
        android:layout_width="320dp"
        android:layout_height="130dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardDetails"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:gravity="center">
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="3dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="5dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="3dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="6dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="3dp"/>
                <View android:layout_width="5dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="2dp"/>
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#000000" android:layout_marginEnd="1dp"/>
                <View android:layout_width="2dp" android:layout_height="match_parent" android:background="#000000"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvBarcodeNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZW-2023-1205-8842"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.25"
                android:fontFamily="monospace"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvInstructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tunjukkan barcode ini kepada donatur untuk diverifikasi saat pengambilan makanan."
        android:textAlignment="center"
        android:textSize="13sp"
        android:textColor="#757575"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="36dp"
        app:layout_constraintTop_toBottomOf="@id/cardBarcode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimulateDone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="SIMULASIKAN SELESAI"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="36dp"
        android:layout_marginBottom="12dp"
        app:backgroundTint="#E64A19"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toTopOf="@id/btnBatal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBatal"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Batal"
        android:textSize="13sp"
        android:layout_marginHorizontal="36dp"
        android:layout_marginBottom="28dp"
        app:strokeColor="#D32F2F"
        android:textColor="#D32F2F"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>